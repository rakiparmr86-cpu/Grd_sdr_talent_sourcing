# Copy to .env and adjust.

GRD_APP_NAME=GRD AI SDR
GRD_DEBUG=false
GRD_DATABASE_URL=sqlite:///./grd.db

# Enrichment providers, comma separated, applied in order (later ones fill gaps).
#   mock -> deterministic synthetic data, no network, good for dev/tests
#   web  -> fetches the company's own website + careers page (real HTTP)
GRD_ENRICHMENT_PROVIDERS=mock,web

# LLM provider used for research summary + signal interpretation.
#   mock   -> deterministic rule-based stand-in, no network
#   ollama -> local Ollama server
GRD_LLM_PROVIDER=mock
GRD_OLLAMA_BASE_URL=http://localhost:11434
GRD_OLLAMA_MODEL=llama3.1

# Which agents/<name>/ config folder to load (config.yaml, workflow.yaml, prompts, icp)
GRD_AGENT=ai_sdr

# ICP profile name -> agents/<GRD_AGENT>/scoring/icp/<name>.yaml
# (defaults to the agent's config.yaml scoring.default_icp)
GRD_ICP=grd_staffing

# Research agent: capability allow-list, staleness cutoff, per-call retries
GRD_RESEARCH_CAPABILITIES=company_lookup,contact_lookup,funding_lookup,tech_lookup,news_search,web_fetch
GRD_RESEARCH_STALE_AFTER_MONTHS=24
GRD_RESEARCH_RETRIES=1

# --- recruiting / talent sourcing ---
# candidate sources, comma separated, applied in order:
#   mock   -> deterministic synthetic candidate, no network
#   github -> reads a candidate's PUBLIC GitHub profile + repos (real HTTP)
GRD_CANDIDATE_SOURCES=mock,github
# optional; raises GitHub API rate limit 60/hr -> 5000/hr
GRD_GITHUB_TOKEN=
# default rubric name (file in grd/recruiting/rubrics/<name>.yaml)
GRD_RUBRIC=backend_engineer_india

GRD_HTTP_TIMEOUT=10
